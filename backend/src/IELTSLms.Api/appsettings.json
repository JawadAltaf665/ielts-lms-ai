{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=ielts_lms;Username=postgres;Password=Postgres123",
    "Redis": "",
    "Hangfire": "Host=localhost;Port=5432;Database=ielts_lms_jobs;Username=postgres;Password=Postgres123"
  },
  "Cache": {
    "InstancePrefix": "ielts-lms:",
    "DefaultAbsoluteExpiration": "00:05:00",
    "EnableStatistics": true
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 100
    },
    "PerIp": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 10
    },
    "PerUser": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 20
    },
    "PerTenant": {
      "PermitLimit": 500,
      "WindowSeconds": 60,
      "QueueLimit": 50
    }
  },
  "Resilience": {
    "Retry": {
      "MaxRetryAttempts": 3,
      "BaseDelayMs": 1000,
      "MaxDelayMs": 30000,
      "UseJitter": true
    },
    "Timeout": {
      "TimeoutSeconds": 30
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "BreakDurationSeconds": 30,
      "SamplingDurationSeconds": 60,
      "FailureRatio": 0.5,
      "MinimumThroughput": 10
    }
  },
  "Performance": {
    "MaxRequestBodySizeBytes": 10485760,
    "RequestTimeoutSeconds": 120,
    "MaxConcurrentConnections": 5000,
    "MaxConcurrentUpgradedConnections": 1000,
    "EnableResponseCompression": true,
    "KeepAliveTimeoutSeconds": 130,
    "MaxRequestHeaderCount": 100,
    "MaxRequestHeadersTotalSizeBytes": 32768
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-Correlation-Id", "X-Tenant-Id" ],
    "ExposedHeaders": [ "X-Correlation-Id", "X-Request-Id", "Retry-After" ],
    "MaxAgeSeconds": 600,
    "AllowCredentials": true
  },
  "Observability": {
    "ServiceName": "ielts-lms-api",
    "ServiceVersion": "1.0.0",
    "Environment": "development",
    "OtlpEndpoint": ""
  },
  "Vocabulary": {
    "DefaultReviewBatchSize": 20,
    "MaxReviewBatchSize": 50
  },
  "Auth": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenSlidingLifetime": "14.00:00:00",
    "SessionAbsoluteLifetime": "30.00:00:00",
    "EmailVerificationTokenLifetime": "1.00:00:00",
    "PasswordResetTokenLifetime": "01:00:00",
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:15:00",
    "EmailVerificationUrl": "https://localhost/verify-email",
    "PasswordResetUrl": "https://localhost/reset-password"
  },
  "Jwt": {
    "Issuer": "ielts-lms-ai",
    "Audience": "ielts-lms-ai",
    "Algorithm": "RS256",
    "PrivateKeyPem": "",
    "PublicKeyPem": "",
    "KeyId": "dev",
    "ClockSkew": "00:00:30"
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSigningSecret": ""
  },
  "Ai": {
    "Claude": {
      "ApiKey": "",
      "BaseUrl": "https://api.anthropic.com",
      "Model": "claude-3-5-haiku-20241022",
      "AnthropicVersion": "2023-06-01",
      "InputCostPerMillionTokensUsd": 0,
      "OutputCostPerMillionTokensUsd": 0
    }
  },
  "Argon2": {
    "MemorySizeKib": 19456,
    "Iterations": 2,
    "DegreeOfParallelism": 1,
    "SaltSizeBytes": 16,
    "HashSizeBytes": 32
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "MaximumLength": 256,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": false
  },
  "Logging": {
    "Behavior": {
      "SlowRequestThresholdMs": 500,
      "MaskedProperties": [ "password", "token", "secret", "authorization" ],
      "EnableRequestBodyLogging": false
    }
  },
  "Audit": {
    "EnableAuditLog": true,
    "EnableActivityLog": true,
    "ExcludedEntities": [ "OutboxMessage" ],
    "ExcludedProperties": [ "PasswordHash", "SecurityStamp" ]
  },
  "AllowedHosts": "*"
}
