{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=ielts_lms;Username=postgres;Password=Postgres123",
    "Redis": "",
    "Hangfire": "Host=localhost;Port=5432;Database=ielts_lms_jobs;Username=postgres;Password=Postgres123"
  },
  "Observability": {
    "ServiceName": "ielts-lms-api",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": ""
  },
  "Auth": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenSlidingLifetime": "14.00:00:00",
    "SessionAbsoluteLifetime": "30.00:00:00",
    "EmailVerificationTokenLifetime": "1.00:00:00",
    "PasswordResetTokenLifetime": "01:00:00",
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:15:00",
    "EmailVerificationUrl": "https://localhost/verify-email",
    "PasswordResetUrl": "https://localhost/reset-password"
  },
  "Jwt": {
    "Issuer": "ielts-lms-ai",
    "Audience": "ielts-lms-ai",
    "Algorithm": "RS256",
    "PrivateKeyPem": "",
    "PublicKeyPem": "",
    "KeyId": "dev",
    "ClockSkew": "00:00:30"
  },
  "Argon2": {
    "MemorySizeKib": 19456,
    "Iterations": 2,
    "DegreeOfParallelism": 1,
    "SaltSizeBytes": 16,
    "HashSizeBytes": 32
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "MaximumLength": 256,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": false
  },
  "Logging": {
    "Behavior": {
      "SlowRequestThresholdMs": 500,
      "MaskedProperties": [ "password", "token", "secret", "authorization" ],
      "EnableRequestBodyLogging": false
    }
  },
  "Audit": {
    "EnableAuditLog": true,
    "EnableActivityLog": true,
    "ExcludedEntities": [ "OutboxMessage" ],
    "ExcludedProperties": [ "PasswordHash", "SecurityStamp" ]
  },
  "AllowedHosts": "*"
}
