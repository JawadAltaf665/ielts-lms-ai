{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=ielts_lms;Username=postgres;Password=Postgres123",
    "Redis": "localhost:6379",
    "Hangfire": "Host=localhost;Port=5432;Database=ielts_lms_jobs;Username=postgres;Password=Postgres123"
  },
  "Observability": {
    "OtlpEndpoint": ""
  },
  "Tenancy": {
    // "localhost" added so a real institute tenant can be exercised locally via
    // http://<slug>.localhost:5000 — browsers resolve *.localhost to loopback with no hosts-file
    // edit (RFC 6761), so host-based resolution (Multi-Tenant Architecture §5.1) works exactly as
    // it will in production against the real root domain, just on a dev-only extra entry.
    "RootDomains": [ "ielts-lms.ai", "localhost" ]
  }
}
