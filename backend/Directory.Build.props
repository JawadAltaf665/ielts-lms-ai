<Project>

  <!--
    Solution-wide build settings for IELTSLms.
    Development Standards §21: analyzers + nullable reference types on; warnings treated as errors in CI.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ProductName>IELTS LMS AI</ProductName>
    <Company>IELTS LMS AI</Company>
    <Product>IELTS LMS AI</Product>
  </PropertyGroup>

</Project>
