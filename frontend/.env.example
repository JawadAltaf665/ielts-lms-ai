# Copy to `.env.local` and adjust. Only VITE_-prefixed vars reach the client
# bundle (Vite's own rule) — never put secrets here (see docs/16 §19).

VITE_API_BASE_URL=http://localhost:5000
VITE_APP_NAME=IELTS LMS AI

# Dev-only: sends X-Tenant-Id on pre-auth calls (login/register/...) so auth works against a bare
# host like localhost, which resolves no tenant by itself (Multi-Tenant Architecture §5.1 — the real
# mechanism is the Host header, e.g. http://acme.ielts-lms.ai in production or http://acme.localhost
# in dev). Leave unset for any real deployment. 00000000-0000-0000-0000-000000000001 is the seeded
# system tenant (individual/direct sign-up).
VITE_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
