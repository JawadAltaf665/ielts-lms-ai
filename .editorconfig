# EditorConfig - https://editorconfig.org
# IELTS LMS AI

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# C# / .NET backend
[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets}]
indent_size = 2

# Web / Frontend
[*.{js,jsx,ts,tsx,vue,css,scss,less,html,json,json5,yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefiles require tabs
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
end_of_line = lf

# Windows scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf
